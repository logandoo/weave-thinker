stage4_ce_skip_strong_top_sim = 0.7
profile_sync_enabled = true
recall_log_enabled = true
recall_log_retention_days = 30
recall_log_max_per_user = 20000
recall_log_sample_rate = 1.0
[memory.concept]
weight_init = 0.5
weight_recall_boost = 0.03
weight_evidence_boost = 0.03
weight_max = 1.0
trust_cap_agent_inferred = 0.7
trust_cap_external = 0.5
hot_forget_threshold = 0.15
avg_weight_reset = true
cold_resurrect_weight = 0.3
maturation_window_days = 21
silent_max_windows = 2
silent_activation_threshold = 0.05
weight_decay_writeback = true
weight_decay_floor = 0.05
[memory.concept.fatigue]
