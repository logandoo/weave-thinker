# Weave Thinker 配置模板（主基础设施配置）。
# 复制为 backend/config.toml 后按部署环境填写。所有 <YOUR-*> 占位必须替换。
# 模型相关配置见 config_model.toml（模板 config_model.toml.example）。

[server]
host = "0.0.0.0"
port = 8158

[security]
jwt_secret_key = "<YOUR-SECRET>"
super_admin_bypass = true

[database]
host = "127.0.0.1"
port = 5432
username = "<YOUR-DB-USER>"
password = "<YOUR-SECRET>"
name = "<YOUR-DB-NAME>"

[agent]
name = "共享智能体"
memory_max_items = 12
note_context_limit = 12
conversation_context_limit = 40
memory_refresh_note_limit = 20
memory_refresh_message_limit = 60
scheduled_task_system_prompt = """你是一个智能助手，正在执行用户设定的定时任务。请根据任务要求完成操作并给出结果。你可以使用 web_search 联网搜索最新信息，使用 browser 浏览网页深入获取内容，使用 execute_code 执行代码。当你不确定某个事实或需要最新信息时，必须主动搜索而不是猜测。

Markdown格式要求（严格遵守，否则渲染会出错）：
- 每个标题（#, ##, ###）前必须有空行，标题的 # 后必须有空格。错误：\"正文###标题\"，正确：\"正文\\n\\n### 标题\"
- 表格起始行 | 前必须有空行。错误：\"文本| 列1 |\"，正确：\"文本\\n\\n| 列1 |\"
- 表格每行之间必须换行，表头分隔行 |---| 必须独占一行
- 禁止标题后紧跟粗体文本，粗体内容应另起一行
- 禁止两个粗体块之间没有换行分隔"""
background_task_system_prompt = """你是一个专业的研究助手。请根据用户的任务，使用搜索和浏览器工具收集信息，最后给出完整的总结。当你不确定某个事实或需要最新信息时，必须主动搜索而不是猜测。

Markdown格式要求（严格遵守，否则渲染会出错）：
- 每个标题（#, ##, ###）前必须有空行，标题的 # 后必须有空格。错误：\"正文###标题\"，正确：\"正文\\n\\n### 标题\"
- 表格起始行 | 前必须有空行。错误：\"文本| 列1 |\"，正确：\"文本\\n\\n| 列1 |\"
- 表格每行之间必须换行，表头分隔行 |---| 必须独占一行
- 禁止标题后紧跟粗体文本，粗体内容应另起一行
- 禁止两个粗体块之间没有换行分隔"""
[agent.tool_loop]
max_iterations = 50
max_consecutive_iterations = 999
memory_read_dedup = true
max_empty_answer_retries = 2
max_force_stage_rounds = 50
max_tool_retry_attempts = 2
keepalive_interval_seconds = 10
parallel_tool_calls = true
tool_call_timeout_seconds = 1800
subtask_iteration_timeout_seconds = 1800
inactivity_timeout_seconds = 3600
judge_timeout_seconds = 300
grace_timeout_seconds = 120
live_thinking = true

[agent.background_tasks]
enabled = true
max_concurrent_tasks = 3
poll_interval_seconds = 3
total_timeout_seconds = 18000
progress_update_interval_seconds = 2
stale_recovery_minutes = 10

[agent.cache]
enabled = false
cache_ttl_minutes = 5

[agent.audit]
reject_budget = 2
numeric_gate_enabled = true
retry_reasoning_keep_chars = 6000
revision_thinking_enabled = false
call_timeout_seconds = 600
revision_min_similarity = 0.45
reject_budget_search = 4
max_evidence_tokens = 128000
soft_reject_limit = 3
draft_selection_enabled = true
selection_timeout_seconds = 480
salvage_timeout_seconds = 240
selection_draft_budget_tokens = 60000
selection_draft_window_chars = 6000
evidence_context_ceiling_tokens = 128000

[agent.canary]
enabled = true
miss_threshold = 2
auto_disable_after = 3
compress_min_ratio = 0.6

[agent.ptc]
enabled = false
allowed_tools = ["web_search", "browser", "memory"]
socket_timeout_seconds = 120

[agent.session_search]
enabled = true

[agent.error_recovery]
enabled = true
max_retries = 2

[agent.delegation]
max_depth = 2
default_child_max_iterations = 999
default_child_timeout = 300

[agent.skill_evolution]
enabled = true
auto_suggest_threshold = 5

[agent.proactive_learning]
enabled = true
user_modeling_enabled = true


[mcp]

[web_search]
enabled = true
provider = "exa"
fallback_providers = ["bocha", "firecrawl", "tavily"]
api_url = ""
api_key = "<YOUR-SECRET>"
exa_api_key = "<YOUR-SECRET>"
bocha_api_key = "<YOUR-SECRET>"
firecrawl_api_key = "<YOUR-SECRET>"
max_results = 10
timeout_seconds = 8.0
max_search_rounds = 3
min_qualified_rounds = 2
blocked_domains = ["wikipedia.org", "wikimedia.org", "youtube.com", "facebook.com", "twitter.com", "instagram.com", "pinterest.com", "reddit.com", "quora.com", "medium.com", "google.com"]

[context7]
api_key = "<YOUR-SECRET>"

[scheduler]
enabled = true
poll_interval_minutes = 15
run_on_startup = true
cleanup_interval_hours = 6
agent_task_retention_days = 7
scheduled_task_retention_days = 30

[workspace]
root_dir = "user_workspaces"
use_project_venv = true
create_readme = true

[browser]
enabled = true
max_content_length = 30000
max_pages = 5
playwright_networkidle_timeout_ms = 3000
playwright_navigation_timeout_ms = 5000
playwright_challenge_wait_ms = 8000
httpx_html_truncation = 500000
min_text_for_skip_playwright = 200
title_truncation = 500
ignore_https_errors = true
[browser.interaction]
enabled = true
session_timeout_seconds = 18000
max_concurrent_sessions = 5


[terminal]
enabled = true
timeout_seconds = 30
max_timeout_seconds = 120
max_output_chars = 10000

[code_execution]
enabled = true
timeout_seconds = 1800
max_output_chars = 128000
gen_max_tokens = 128000
max_retries = 6
total_timeout_seconds = 1800.0
repair_offset_tokens = 400
repair_extra_tokens = 400
grace_period_seconds = 5.0
