clarification_auto_apply_threshold = 0.8
clarification_pending_threshold = 0.5
embedding_dim_override = true
embedding_cache_size = 100
embedding_provider_check_on_startup = true
rerank_enabled = true
stage4_llm_enabled = true
stage4_llm_trigger_score_gap = 0.1
