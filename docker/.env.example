# Weave Thinker Docker 环境变量（复制为仓库根 .env 后按需修改）
# cp docker/.env.example .env

# PostgreSQL 账号（须与 backend/config.toml [database] 一致）
POSTGRES_USER=weavethinker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=weavethinker

# 应用对外端口（宿主机）
APP_PORT=8158

# 构建镜像时附带 Playwright Chromium（浏览器工具；镜像显著增大，默认 0）
# WITH_BROWSER=1

# 受限网络构建加速（可选，留空=官方源；改完执行 ./scripts/docker_start.sh 重建）
# NPM_REGISTRY=https://registry.npmmirror.com
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# SELinux 系统（Fedora/RHEL/CentOS）bind mount 需重打标签（改后需重建容器，restart 不生效）：
# WT_MOUNT_OPTS=ro,z
